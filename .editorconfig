# dist/fieldbook.html is assembled by concatenating src/ fragments verbatim, so
# editor hygiene is load-bearing: a stripped final newline or a changed line
# ending shows up as a byte diff in the shipped app.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
