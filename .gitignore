# Build artifacts
# NB: dist/fieldbook.html is deliberately TRACKED — it's the release artifact,
# the file the in-app update badge points players at, and the reference the
# builder's clobber guard compares against. Only the derived bits are ignored.
dist/*.zip
dist/*_full.json
dist/.buildstamp
.buildtmp/
.buildkit/

# Node / tooling
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
# No trailing slash: scripts/wt.sh symlinks these into each worktree, and a
# symlink is a FILE to git — `.venv/` would not match it, leaving an untracked
# symlink that `git add -A` would happily commit as a broken path.
.venv
venv/

# Editor / OS
# `.claude/*`, not `.claude/`: the trailing-slash form stops git descending into
# the directory, so no `!` rule beneath it can ever take effect. Project skills
# are tracked so every clone and every worktree gets them; worktrees, QA
# screenshots and settings.local.json stay ignored. build.sh bans dot-paths from
# the player zip, so a skill cannot ship.
.claude/*
!.claude/skills/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local scratch
*.OLD.json
*.PREV.json
/_classmap.json
/_app.js

# Data for conversion (large source PDFs and 5e-tools dumps)
/_conversion-data
.playwright-mcp/
