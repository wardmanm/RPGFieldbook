# Build artifacts
# NB: dist/fieldbook.html is deliberately TRACKED — it's the release artifact,
# the file the in-app update badge points players at, and the reference the
# builder's clobber guard compares against. Only the derived bits are ignored.
dist/*.zip
dist/*_full.json
dist/.buildstamp
.buildtmp/

# Node / tooling
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.claude/
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local scratch
*.OLD.json
*.PREV.json
/_classmap.json
/_app.js

# Data for conversion (large source PDFs and 5e-tools dumps)
/_conversion-data/
.playwright-mcp/
